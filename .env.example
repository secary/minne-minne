# Host-side API / Worker connection; the container uses db:5432 instead.
MINNE_DATABASE_URL=postgresql+psycopg://minne:minne@localhost:5432/minne
MINNE_RAW_DIR=knowledge/raw
MINNE_USER_AGENT="MinneMinne/0.1 (personal knowledge archive; contact: replace-me)"
# Local long-running Worker only; the one-round container ignores this setting.
MINNE_POLL_SECONDS=30

# Compose PostgreSQL password; update MINNE_DATABASE_URL above to match.
POSTGRES_PASSWORD=minne
# The crawler container completes one round and exits; schedule it externally.
# Optional container overrides (raw directory must already exist and be writable).
# SOURCE_CRAWLER_DATABASE_URL=postgresql+psycopg://minne:minne@db:5432/minne
# SOURCE_CRAWLER_RAW_DIR=./knowledge/raw
# SOURCE_CRAWLER_UID=1000
# SOURCE_CRAWLER_GID=1000
# Container-only proxies; Compose maps these to HTTP(S)_PROXY / ALL_PROXY / NO_PROXY.
# Keep host-side proxy settings separate; localhost inside a container is itself.
# SOURCE_CRAWLER_HTTP_PROXY=http://host.docker.internal:7890
# SOURCE_CRAWLER_HTTPS_PROXY=http://host.docker.internal:7890
# SOURCE_CRAWLER_ALL_PROXY=socks5://host.docker.internal:7890
# SOURCE_CRAWLER_NO_PROXY=localhost,127.0.0.1,db
